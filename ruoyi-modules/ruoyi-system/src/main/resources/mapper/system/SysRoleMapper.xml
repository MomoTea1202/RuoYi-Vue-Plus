<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.system.mapper.SysRoleMapper">

    <resultMap type="org.dromara.system.domain.vo.SysRoleVo" id="SysRoleResult">
    </resultMap>

    <sql id="selectRoleVo">
        select distinct r.role_key,
                        r.role_name,
                        r.role_sort,
                        r.status,
                        r.create_time
        from sys_role r
                 left join sys_user_role sur on sur.role_key = r.role_key
                 left join sys_user u on u.user_id = sur.user_id
    </sql>

    <select id="selectPageRoleList" resultMap="SysRoleResult">
        SELECT * FROM sys_role r
        ${ew.getCustomSqlSegment}
    </select>

    <select id="selectRoleList" resultMap="SysRoleResult">
        SELECT * FROM sys_role r
        ${ew.getCustomSqlSegment}
    </select>

    <select id="selectRolePermissionByUserId" parameterType="Long" resultMap="SysRoleResult">
        <include refid="selectRoleVo"/>
        WHERE sur.user_id = #{userId}
    </select>

    <select id="selectRolesByUserId" parameterType="Long" resultMap="SysRoleResult">
        select r.role_key,
               r.role_name,
               r.role_sort,
               r.status
        from sys_role r
        WHERE r.role_key in (select role_key from sys_user_role where user_id = #{userId})
    </select>

    <select id="selectRoleByKey" resultMap="SysRoleResult">
        <include refid="selectRoleVo"/>
        WHERE  r.role_key = #{roleKey}
    </select>

    <select id="selectRoleByRoleKey" resultMap="SysRoleResult">
        SELECT * from sys_role
        WHERE  role_key = #{roleKey}
    </select>


</mapper>
